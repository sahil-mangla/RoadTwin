# Placeholder values only -- never commit real secrets here.
# The skeleton routes (backend/routes/skeleton.py, mounted in Plan 02) are
# unauthenticated (threat T-01-07). SKELETON_ROUTES_ENABLED must be set to
# `false` outside local development.
SKELETON_ROUTES_ENABLED=true
DATABASE_URL=postgresql+asyncpg://roadtwin:roadtwin_dev@localhost:5432/roadtwin
DATABASE_URL_SYNC=postgresql+psycopg://roadtwin:roadtwin_dev@localhost:5432/roadtwin

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=roadtwin
MINIO_SECRET_KEY=roadtwin_dev_secret
MINIO_SECURE=false
MINIO_BUCKET=roadtwin-reports
# Mandatory outside local dev: with no value set, the process mints an
# ephemeral per-restart secret and every device identity is invalidated on
# every restart (see backend/core/config.py's resolve_device_id_cookie_secret).
DEVICE_ID_COOKIE_SECRET=
DEVICE_ID_COOKIE_SECURE=false

IDENTITY_RATE_LIMIT_PER_HOUR=10
IP_RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_WINDOW_SECONDS=3600
GPS_COOLDOWN_METERS=15.0
GPS_COOLDOWN_SECONDS=300
MAX_UPLOAD_BYTES=10485760
